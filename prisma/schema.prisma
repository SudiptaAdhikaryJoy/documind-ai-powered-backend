generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    OWNER
    MEMBER
    VIEWER
}

enum Plan {
    FREE
    TEAM
    BUSINESS
}

enum Status {
    PENDING
    INDEXING
    READY
    FAILED
}

enum OtpPurpose {
    SIGNUP_EMAIL_VERIFICATION
    SIGNUP_PHONE_VERIFICATION
    PASSWORD_RESET
    PHONE_LOGIN
    STEP_UP_ACTION
}

model RefreshToken {
    id        String    @id @default(uuid())
    userId    String
    tokenHash String    @unique
    expiresAt DateTime
    revokedAt DateTime?
    createdAt DateTime  @default(now())
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model User {
    id              String         @id @default(uuid())
    email           String         @unique
    phone           String         @unique
    password        String
    name            String
    isEmailVerified Boolean        @default(false)
    isPhoneVerified Boolean        @default(false)
    createdAt       DateTime       @default(now())
    members         Membership[]
    refreshTokens   RefreshToken[]

    @@unique([id, name])
}

model Workspace {
    id        String            @id @default(uuid())
    name      String
    plan      Plan              @default(FREE)
    createdAt DateTime          @default(now())
    members   Membership[]
    documents Document[]
    invites   WorkspaceInvite[]

    @@unique([id, name])
}

model Otp {
    id          String     @id @default(uuid())
    target      String
    codeHash    String
    purpose     OtpPurpose
    attempts    Int        @default(0)
    maxAttempts Int        @default(5)
    expiresAt   DateTime
    consumedAt  DateTime?
    createdAt   DateTime   @default(now())

    @@index([target, purpose])
}

model WorkspaceInvite {
    id          String    @id @default(uuid())
    workspaceId String
    email       String
    role        Role      @default(MEMBER)
    tokenHash   String    @unique
    expiresAt   DateTime
    acceptedAt  DateTime?
    createdAt   DateTime  @default(now())
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@index([workspaceId, email])
}

model Membership {
    id            String    @id @default(uuid())
    userId        String
    workspaceId   String
    memberName    String
    workspaceName String
    role          Role      @default(MEMBER)
    user          User      @relation(fields: [userId, memberName], references: [id, name], onDelete: Cascade)
    workspace     Workspace @relation(fields: [workspaceId, workspaceName], references: [id, name], onDelete: Cascade)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @default(now()) @updatedAt

    @@unique([userId, workspaceId])
    @@index([workspaceId])
}

model Document {
    id          String    @id @default(uuid())
    workspaceId String
    title       String
    kind        String    @default("other")
    status      Status    @default(PENDING)
    pageCount   Int       @default(0)
    createdAt   DateTime  @default(now())
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    versions    Version[]

    @@index([workspaceId, status])
}

model Version {
    id         String   @id @default(uuid())
    documentId String
    label      String
    byteSize   Int
    sha256     String
    createdAt  DateTime @default(now())
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
    chunks     Chunk[]

    @@unique([documentId, label])
}

model Chunk {
    id        String                      @id @default(uuid())
    versionId String
    ordinal   Int
    page      Int
    heading   String?
    content   String
    tokens    Int                         @default(0)
    embedding Unsupported("vector(768)")?
    version   Version                     @relation(fields: [versionId], references: [id], onDelete: Cascade)

    @@index([versionId])
}

model QueryLog {
    id          String   @id @default(uuid())
    workspaceId String
    userId      String
    question    String
    abstained   Boolean  @default(false)
    reason      String?
    model       String
    promptTok   Int      @default(0)
    outputTok   Int      @default(0)
    latencyMs   Int      @default(0)
    createdAt   DateTime @default(now())

    @@index([workspaceId, createdAt])
}
